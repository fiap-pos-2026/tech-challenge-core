<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="008-create-quote-service-lines" author="johncgo">
        <createTable tableName="quote_service_lines">
            <column name="_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="_quote_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="_mechanical_service_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="_name_snapshot" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="_price_snapshot" type="NUMERIC(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="_estimated_duration_minutes" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="quote_service_lines" indexName="idx_quote_service_lines_quote_id">
            <column name="_quote_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="quote_service_lines"/>
        </rollback>
    </changeSet>

    <changeSet id="008-fk-quote-service-lines-quote" author="johncgo">
        <addForeignKeyConstraint
                constraintName="fk_quote_service_lines_quote_id"
                baseTableName="quote_service_lines"
                baseColumnNames="_quote_id"
                referencedTableName="quotes"
                referencedColumnNames="_id"
                onDelete="CASCADE"
                onUpdate="NO ACTION"/>

        <rollback>
            <dropForeignKeyConstraint
                    baseTableName="quote_service_lines"
                    constraintName="fk_quote_service_lines_quote_id"/>
        </rollback>
    </changeSet>

    <changeSet id="008-fk-quote-service-lines-mechanical-service" author="johncgo">
        <addForeignKeyConstraint
                constraintName="fk_quote_service_lines_mechanical_service_id"
                baseTableName="quote_service_lines"
                baseColumnNames="_mechanical_service_id"
                referencedTableName="mechanical_services"
                referencedColumnNames="_id"
                onDelete="RESTRICT"
                onUpdate="NO ACTION"/>

        <rollback>
            <dropForeignKeyConstraint
                    baseTableName="quote_service_lines"
                    constraintName="fk_quote_service_lines_mechanical_service_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
