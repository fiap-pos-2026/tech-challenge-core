<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="022-add-not-null-to-users-uuid" author="pauloogsouza">
        <addNotNullConstraint tableName="users" columnName="_uuid" columnDataType="UUID"/>

        <rollback>
            <dropNotNullConstraint tableName="users" columnName="_uuid" columnDataType="UUID"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
