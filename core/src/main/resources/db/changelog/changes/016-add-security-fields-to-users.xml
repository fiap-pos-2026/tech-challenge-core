<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="016-add-security-fields-to-users" author="johncgo">
        <addColumn tableName="users">
            <column name="_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="users">
            <column name="_tentativas_login_falha" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="users">
            <column name="_bloqueado_ate" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="users" columnName="_active"/>
            <dropColumn tableName="users" columnName="_tentativas_login_falha"/>
            <dropColumn tableName="users" columnName="_bloqueado_ate"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
