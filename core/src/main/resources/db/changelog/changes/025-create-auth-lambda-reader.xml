<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <!--
        Usuário só de leitura para a Lambda de autenticação (tech-challenge-auth-lambda).
        Enxerga apenas as colunas de customers usadas no login por CPF.

        Só roda quando o parâmetro authReaderPassword vem preenchido
        (spring.liquibase.parameters.authReaderPassword ← env AUTH_DB_READER_PASSWORD).
        Sem ele (dev, testes, docker-compose) o changeset é pulado sem marcar como executado.
        runAlways + runOnChange: cria o usuário na primeira vez e reaplica senha/permissões
        a cada start, então trocar o secret basta para rotacionar a senha.
    -->
    <changeSet id="025-create-auth-lambda-reader" author="johncgo" dbms="postgresql"
               runAlways="true" runOnChange="true">
        <preConditions onFail="CONTINUE">
            <and>
                <changeLogPropertyDefined property="authReaderPassword"/>
                <not>
                    <changeLogPropertyDefined property="authReaderPassword" value=""/>
                </not>
            </and>
        </preConditions>

        <sql splitStatements="false">
            DO $$
            BEGIN
                IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'auth_lambda_reader') THEN
                    CREATE ROLE auth_lambda_reader LOGIN PASSWORD '${authReaderPassword}';
                ELSE
                    ALTER ROLE auth_lambda_reader WITH LOGIN PASSWORD '${authReaderPassword}';
                END IF;
                EXECUTE format('GRANT CONNECT ON DATABASE %I TO auth_lambda_reader', current_database());
            END
            $$;
        </sql>
        <sql>
            GRANT USAGE ON SCHEMA public TO auth_lambda_reader;
            REVOKE ALL ON customers FROM auth_lambda_reader;
            GRANT SELECT (_uuid, _name, _active, _document_type, _document) ON customers TO auth_lambda_reader;
        </sql>
    </changeSet>

</databaseChangeLog>
