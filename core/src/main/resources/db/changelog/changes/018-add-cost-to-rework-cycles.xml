<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="018-add-cost-to-rework-cycles" author="pauloogsouza">
        <addColumn tableName="rework_cycles">
            <column name="_estimated_duration_minutes" type="INT"/>
            <column name="_estimated_internal_cost" type="NUMERIC(15,2)"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="rework_cycles" columnName="_estimated_duration_minutes"/>
            <dropColumn tableName="rework_cycles" columnName="_estimated_internal_cost"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
