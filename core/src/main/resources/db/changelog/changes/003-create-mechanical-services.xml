<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="003-create-mechanical-services" author="johncgo">
        <createTable tableName="mechanical_services">
            <column name="_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="_uuid" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_mechanical_services_uuid"/>
            </column>
            <column name="_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="_description" type="TEXT"/>
            <column name="_base_price" type="NUMERIC(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="_estimated_duration_minutes" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="_created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="_updated_at" type="TIMESTAMP"/>
        </createTable>

        <rollback>
            <dropTable tableName="mechanical_services"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
