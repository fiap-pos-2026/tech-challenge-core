# Copie para runtime.env (não versionado). Em prod os serviços de apoio são gerenciados.
JDBC_HOST=<endpoint-do-rds-prod>
REDIS_HOST=<endpoint-do-elasticache>
MAIL_HOST=<smtp-do-provedor>
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# INTERNAL (login de funcionário) | LAMBDA (só JWT de cliente da Lambda)
AUTH_MODE=INTERNAL
CUSTOMER_JWT_ISSUER=https://<api-gateway-prod>/auth
CUSTOMER_JWT_JWKS_URI=https://<api-gateway-prod>/auth/.well-known/jwks.json
