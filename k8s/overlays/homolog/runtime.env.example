# Copie para runtime.env (não versionado) para aplicar à mão: kubectl apply -k k8s/overlays/homolog
# No CI este arquivo é gerado a partir da conta AWS do lab.
JDBC_HOST=<endpoint-do-rds>
# INTERNAL (login de funcionário) | LAMBDA (só JWT de cliente da Lambda)
AUTH_MODE=INTERNAL
CUSTOMER_JWT_ISSUER=https://<api-gateway>/auth
CUSTOMER_JWT_JWKS_URI=https://<api-gateway>/auth/.well-known/jwks.json
